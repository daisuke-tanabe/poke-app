generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Pokemon {
  id          Int         @id @default(autoincrement())
  name_ja     String
  name_kana   String
  name_en     String
  formEntries FormEntry[]
}

model Form {
  id          Int         @id @default(autoincrement())
  name_ja     String
  name_en     String
  region_id   Int         @default(1)
  region      Region      @relation(fields: [region_id], references: [id])
  formEntries FormEntry[]
}

model FormEntry {
  id             Int            @id @default(autoincrement())
  pokemon_id     Int
  form_id        Int
  sprite_default String
  sprite_shiny   String
  order          Int
  form           Form           @relation(fields: [form_id], references: [id])
  pokemon        Pokemon        @relation(fields: [pokemon_id], references: [id], onDelete: Cascade)
  pokedexEntries PokedexEntry[]
  typeEntries    TypeEntry[]

  @@unique([pokemon_id, order])
}

model Region {
  id        Int       @id
  name_ja   String
  name_en   String
  slug      String    @unique
  forms     Form[]
  pokedexes Pokedex[]
}

model Pokedex {
  id        Int            @id
  region_id Int
  name_ja   String
  name_en   String
  slug      String         @unique
  region    Region         @relation(fields: [region_id], references: [id])
  entries   PokedexEntry[]
}

model PokedexEntry {
  id            Int         @id @default(autoincrement())
  pokedex_id    Int
  form_entry_id Int
  entry_number  Int
  formEntry     FormEntry   @relation(fields: [form_entry_id], references: [id], onDelete: Cascade)
  pokedex       Pokedex     @relation(fields: [pokedex_id], references: [id], onDelete: Cascade)
  typeEntries   TypeEntry[]

  @@unique([pokedex_id, entry_number, form_entry_id])
}

model Type {
  id          Int         @id
  name_ja     String
  name_en     String
  slug        String      @unique
  typeEntries TypeEntry[]
}

model TypeEntry {
  id               Int          @id @default(autoincrement())
  pokedex_entry_id Int
  type_id          Int
  form_entry_id    Int
  formEntry        FormEntry    @relation(fields: [form_entry_id], references: [id], onDelete: Cascade)
  pokedexEntry     PokedexEntry @relation(fields: [pokedex_entry_id], references: [id], onDelete: Cascade)
  type             Type         @relation(fields: [type_id], references: [id], onDelete: Cascade)

  @@unique([pokedex_entry_id, type_id])
}
